# Starship Nickalas Backend — Environment Template
# Copy to .env or docker.env and fill in real values. NEVER commit real secrets.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PROJECT=your-project-ref
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Fernet symmetric encryption key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=your-fernet-key-here

# Core
CORE_VERSION=nickalas_core_v2
LOG_LEVEL=info

# Health endpoints bind
HEALTH_PORT=8080